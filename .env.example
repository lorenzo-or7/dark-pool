# DARK POOL v0.1 — exemplo de configuração. Copie para .env (backend) e frontend/.env.local (frontend).
# Nunca coloque valores reais neste arquivo. Nunca exponha a service role key no frontend.

# ---------------------------------------------------------------- backend (.env na raiz ou backend/.env)

# demo     = workspace local em SQLite e sessão de demonstração (só funciona em localhost)
# supabase = login real (Supabase Auth) e banco Supabase Postgres com RLS
DP_AUTH_MODE=demo

# Conexão direta ao Postgres do Supabase (Project Settings > Database > Connection string, modo "Session").
# O backend executa cada requisição como o papel `authenticated` com o JWT do usuário, então o RLS vale.
DATABASE_URL=

SUPABASE_URL=
# Chave pública (anon / publishable). Usada pelo backend só para o Storage com o token do próprio usuário.
SUPABASE_ANON_KEY=
# Apenas para projetos com chave JWT legada (HS256). Projetos com chaves assimétricas usam o JWKS automaticamente.
SUPABASE_JWT_SECRET=

# Origens do frontend permitidas pelo CORS
DP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A SEC exige identificação "Nome email" para o trader-news (8-K) e o trader-analyst.
SEC_USER_AGENT=

# Tarefas em segundo plano
DP_JOB_WORKERS=2
DP_JOB_TIMEOUT_S=600

# ---------------------------------------------------------------- somente para scripts/invite_member.py (nunca no frontend)
SUPABASE_SERVICE_ROLE_KEY=
DP_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------- frontend (frontend/.env.local)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
