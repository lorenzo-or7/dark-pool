# DARK POOL — exemplo de configuração. Copie para .env (backend) e frontend/.env.local (frontend).
# Nunca coloque valores reais neste arquivo. Senhas do banco, service role / secret key e
# connection strings ficam só no backend (Render ou .env local, fora do git).

# ---------------------------------------------------------------- backend (.env na raiz ou backend/.env)

# demo     = workspace local em SQLite (só localhost), para desenvolvimento
# public   = laboratório compartilhado sem login: todos os visitantes usam o workspace abaixo
# supabase = modo antigo com login por membro (a interface atual não tem tela de login)
DP_AUTH_MODE=demo

# Modo public: UUID do workspace DARK POOL existente (veja scripts/setup_public_lab.py --list-workspaces).
DP_PUBLIC_WORKSPACE_ID=
# Opcional: id da identidade técnica. Vazio = derivado do workspace (recomendado).
DP_PUBLIC_IDENTITY_ID=

# Postgres do Supabase. No Render use a string do "Session pooler" (IPv4):
# Project Settings > Database > Connection string > Session pooler.
DATABASE_URL=

SUPABASE_URL=
# Só no servidor. Usada para os buckets privados (snapshots e anexos). Aceita a nova
# secret key (sb_secret_...) ou a service_role legada. Nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=
# auto = Supabase Storage quando SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY existem; senão disco local
DP_STORAGE=auto

# Modo supabase (antigo) apenas:
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Origens do frontend autorizadas pelo CORS (separadas por vírgula). CORS não é autenticação.
DP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A SEC exige identificação "Nome email" para o trader-news (8-K) e o trader-analyst.
SEC_USER_AGENT=

# Alpaca Market Data, plano Basic (feed IEX). Só no backend: nunca use prefixo VITE_.
# Chaves geradas no painel da Alpaca; sem elas o provedor fica desativado.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Política de exibição (vale para todos os visitantes). Vazio = padrão do modo:
# tudo visível no demo local; restritivo no modo public. Defina true/false só para mudar o padrão.
# DP_SHOW_RAW_PRICES          preços, candles e cotações brutos na API pública
# DP_SHOW_TRIGGER_PRICES      preço do gatilho nos sinais (aguarda confirmação do provedor)
# DP_PELOSI_PUBLIC            página pública do Pelosi (aguarda parecer sobre 5 U.S.C. 13107); padrão false
# DP_ALLOW_UNOFFICIAL_SOURCES Yahoo Finance (termos não permitem uso automatizado em site público)
DP_SHOW_RAW_PRICES=
DP_SHOW_TRIGGER_PRICES=
DP_PELOSI_PUBLIC=
DP_ALLOW_UNOFFICIAL_SOURCES=

# Tarefas em segundo plano
DP_JOB_WORKERS=2
DP_JOB_TIMEOUT_S=600
# Tarefas simultâneas (na fila ou rodando) no laboratório; acima disso: HTTP 429 queue_full
DP_MAX_ACTIVE_JOBS=4
DP_MARK_INTERRUPTED_ON_START=true

# Limites por IP por minuto (0 desativa) e tamanho de requisições
DP_RATE_LIMIT_PER_MIN=180
DP_RATE_LIMIT_WRITES_PER_MIN=40
DP_RATE_LIMIT_JOBS_PER_MIN=6
DP_MAX_BODY_BYTES=262144
DP_MAX_UPLOAD_BYTES=5242880
# Proxies que acrescentam o IP do visitante em X-Forwarded-For (Render: 1). Local: 0.
DP_TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------- somente para scripts/invite_member.py (nunca no frontend)
DP_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------- frontend (frontend/.env.local ou variáveis da Vercel)
# Endereço do backend em produção (sem /api no final). Vazio = mesma origem (proxy do Vite em dev).
VITE_API_URL=
# Só para o build da landing no GitHub Pages: link do laboratório completo (Vercel).
VITE_LAB_URL=
